# ===== Forum ENICarthage Configuration =====
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git

# ===== DATABASE =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=forum_enicarthage
DB_USERNAME=root
DB_PASSWORD=root123

# ===== JWT =====
# Generate a Base64-encoded string (min 256 bits / 64 characters)
APP_JWT_SECRET=3cfa76ef14937c1c0ea519f8fc057a80fcd04a7420f8e8bcd0a7567c272e007b
APP_JWT_EXPIRATION=86400000

# ===== Google OAuth2 =====
# Get these from: https://console.cloud.google.com/
# OAuth2 > Credentials > Create OAuth 2.0 Client ID (Web application)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE

# ===== SERVER =====
SERVER_PORT=8080
SERVER_URL=http://localhost:8080
FRONTEND_URL=http://localhost:4200

# ===== CORS =====
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000
ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS

# ===== EMAIL (Optional) =====
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@forum-enicarthage.tn

# ===== ENVIRONMENT =====
ENVIRONMENT=development
# development, staging, production
